                {
                  "dsDescriptionValue": {
                    "typeName": "dsDescriptionValue",
                    "multiple": false,
                    "typeClass": "primitive",
                    "value": "<p>This dataset contains rosbag files featuring an extensive set of sensors: 1 IMU, 2 Lidars, 2 cameras, 4 UWB nodes, mounted on a DJI Matrice 600 Hexacopter. The data were collected at different locations in NTU, Singapore.\n</p>\n\n<p>\nPlease visit the project's website at <a href=\"https://ntu-aris.github.io/ntu_viral_dataset/\">https://ntu-aris.github.io/ntu_viral_dataset/</a> for more information.\n</p>"
                  },
                  "dsDescriptionDate": {
                    "typeName": "dsDescriptionDate",
                    "multiple": false,
                    "typeClass": "primitive",
                    "value": "2021"
                  }
                }
              ]
